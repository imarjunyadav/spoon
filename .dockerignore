# Build Context Exclusions
node_modules
.git
.gitignore
.dockerignore
.gcloudignore
.env
.env.*
# Also exclude NESTED env files (e.g. backend/.env) — a bare ".env" pattern does not
# match subdirectories, so without these the real secrets file would be copied into the image.
**/.env
**/.env.*
backend/.env
logs
tmp
tests
.vscode
.idea

# Antigravity Internal Files (Private)
.agent/
.agent_workflows/
.agent-workflows/
*.agent
*.md
deploy.ps1
DEPLOYMENT_STEPS.md
DEPLOYMENT_STEPS_EASY.md
