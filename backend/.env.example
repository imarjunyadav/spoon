# ========================================
# SPOON - ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual credentials
# 3. NEVER commit .env to version control
#
# ========================================

# Razorpay Keys (from Dashboard → Settings → API Keys)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret_here

# Razorpay Webhook Secret (from Dashboard → Settings → Webhooks)
# Get from: https://dashboard.razorpay.com/app/webhooks
# Required for webhook signature verification (prevents replay attacks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Supabase Credentials (from Dashboard → Settings → API)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ IMPORTANT: Service Role Key (KEEP SECRET - Never expose in frontend!)
# This key bypasses RLS and is needed for admin operations
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server Configuration
PORT=7070
NODE_ENV=development

# Redis Configuration (Required for OTP Storage & Rate Limiting)
# Used by: OTP session storage, rate limiting
# For local development: redis://localhost:6379
# For production: Use managed Redis (Upstash, Redis Cloud, etc.)
REDIS_URL=redis://localhost:6379
# Optional: Redis password (if your Redis instance requires authentication)
# REDIS_PASSWORD=your_redis_password_here

# SMTP Email Credentials (Required for OTP Verification & Order Notifications)
# Used by: Email OTP verification, Order confirmation emails
# For Gmail: Enable 2FA and create App Password
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Note: OTP Configuration (hardcoded in backend/services/otpStore.js)
# - OTP Expiry: 5 minutes
# - Rate Limit: 5 requests per 15 minutes
# - Max Verification Attempts: 5 per OTP session

# WhatsApp Notifications via OpenWA (self-hosted OpenWA/WAHA HTTP API)
# Local dev: point OPENWA_API_URL at your local OpenWA instance (e.g. http://localhost:2785/api).
# Production: set OPENWA_API_URL to the institution's OpenWA server (NOT localhost), and make sure
#   deploy.ps1 forwards OPENWA_API_URL / OPENWA_API_KEY / OPENWA_SESSION_NAME / WHATSAPP_ENABLED to
#   Cloud Run — they are NOT forwarded by default, so WhatsApp stays disabled in prod until added.
# The code degrades gracefully: if WHATSAPP_ENABLED!='true' or the server is unreachable, order-ready
# messages are simply skipped (non-blocking) and never affect the order/payment flow.
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_SESSION_NAME=spoon-notifications
WHATSAPP_ENABLED=false

# Partner Sign-In (password login for a single pre-provisioned account)
# Disabled unless REVIEW_LOGIN_ENABLED is exactly "true". When unset/false the
# /api/auth/partner-login route returns 404. Only REVIEW_EMAIL may use it, and the
# password is stored ONLY as a bcrypt hash here — never in the database or source.
# Generate a hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
REVIEW_LOGIN_ENABLED=false
REVIEW_EMAIL=
REVIEW_PASSWORD_HASH=
